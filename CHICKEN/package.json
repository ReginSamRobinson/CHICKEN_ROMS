{
  "name": "chicken-restaurant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cd backend && node --watch server.js\" \"cd frontend && vite\"",
    "build": "cd frontend && vite build",
    "lint": "cd frontend && oxlint",
    "preview": "cd frontend && vite preview",
    "start": "cd backend && node server.js",
    "seed": "cd backend && node server.js --seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}